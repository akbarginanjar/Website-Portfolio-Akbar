---
import Lanyard from "@/components/Lanyard.jsx";

const skills = [
  { en: "Web Development",         id: "Pengembangan Web",    su: "Pangembangan Web" },
  { en: "Mobile Development",      id: "Pengembangan Mobile", su: "Pangembangan Mobile" },
  { en: "Fullstack",               id: "Fullstack",           su: "Fullstack" },
  { en: "Graphic Design",          id: "Desain Grafis",       su: "Desain Grafis" },
  { en: "Artificial Intelligence", id: "Artificial Intelligence", su: "Artificial Intelligence" },
  { en: "UI/UX",                   id: "UI/UX",               su: "UI/UX" },
];
---
<section class="about" id="about">
  <div class="section-head">
    <h2 class="section-title" data-split data-i18n="about.title" data-i18n-direct>About</h2>
  </div>
  <div class="about-grid">
    <div class="about-copy">
      <p data-reveal data-i18n="about.p1" data-i18n-direct>
        I'm Akbar Ginanjar, a student of Bachelor of Informatics Engineering
        (S1 Teknik Informatika) at STMIK Mardira Indonesia, and a developer
        focused on building modern web and mobile applications. I work across
        frontend, backend and mobile ecosystems, and spend increasing amounts
        of time exploring how AI can make digital products more intelligent.
      </p>
      <p data-reveal data-i18n="about.p2" data-i18n-direct>
        My work spans a range of digital products, from government
        platforms, mobile commerce, and disaster response systems, to ERP
        platforms and e-course systems, with a focus on solutions that are
        functional, modern, and deliver a great user experience.
      </p>

      <!-- Skill Tags -->
      <div class="about-skills" data-reveal>
        {skills.map((s) => (
          <span
            class="about-skill-tag"
            data-i18n-skill-en={s.en}
            data-i18n-skill-id={s.id}
            data-i18n-skill-su={s.su}
          >{s.en}</span>
        ))}
      </div>

      <!-- CAVA Perfume Card -->
      <div class="about-cava-card" data-reveal>
        <div class="about-cava-avatar">
          <img src="/assets/cava-logo.jpg" alt="CAVA Parfums" />
        </div>
        <span class="about-cava-label" data-i18n="about.cava.label" data-i18n-direct>Owner · CAVA Perfume</span>
        <a
          href="https://cavaperfume.vercel.app"
          target="_blank"
          rel="noopener noreferrer"
          class="about-cava-btn"
          aria-label="Visit CAVA Perfume website"
        >
          <span data-i18n="about.cava.btn" data-i18n-direct>Visit</span>
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M1.5 10.5L10.5 1.5M10.5 1.5H4.5M10.5 1.5V7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
    <div class="about-photo" data-reveal>
      <Lanyard
        client:only="react"
        position={[0, 0, 13.5]}
        gravity={[0, -40, 0]}
        frontImage="/assets/akbar-front.jpg"
        backImage="/assets/akbar-back.jpg"
        imageFit="cover"
        name="Akbar Ginanjar"
        role="Web & Mobile Developer"
      />
    </div>
  </div>
</section>
