---
const certificates = [
  {
    id: "1",
    title: "Icommits & SMK Assalaam — Mobile Programming & Web Application Training",
    imageSrc: "/assets/certs/icommits-training.jpg",
  },
  {
    id: "2",
    title: "AI Ready ASEAN — Certificate of Completion",
    imageSrc: "/assets/certs/ai-ready-asean.jpg",
  },
  {
    id: "3",
    title: "CODEPOLITAN — Belajar JavaScript Dasar",
    imageSrc: "/assets/certs/codepolitan-javascript.jpg",
  },
];
---

<section class="certificates" id="certificates" aria-labelledby="certificates-title">
  <div class="section-head certificates-head">
    <h2 class="section-title" id="certificates-title" data-split data-i18n="certificates.title" data-i18n-direct>
      Certificates
    </h2>
  </div>

  <div
    class="card-stack"
    data-card-stack
    data-reveal
    role="region"
    aria-roledescription="carousel"
    aria-label="Certificates"
  >
    <div class="card-stack__stage" data-card-stack-stage tabindex="0">
      <div class="card-stack__wash" aria-hidden="true"></div>
      <ul class="card-stack__list">
        {certificates.map((cert, i) => (
          <li
            class="card-stack__item"
            data-card-stack-item
            data-index={i}
            data-preview-src={cert.imageSrc}
            data-preview-title={cert.title}
          >
            <button
              type="button"
              class="cert-card"
              data-active={i === 0 ? "true" : "false"}
              aria-label={`Preview ${cert.title}`}
            >
              <img
                class="cert-card__img"
                src={cert.imageSrc}
                alt=""
                draggable="false"
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
              />
            </button>
          </li>
        ))}
      </ul>
    </div>

    <div class="card-stack__controls">
      <button type="button" class="card-stack__nav" data-card-stack-prev aria-label="Previous certificate">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="card-stack__dots" role="tablist" aria-label="Certificate slides">
        {certificates.map((cert, i) => (
          <button
            type="button"
            class:list={["card-stack__dot", i === 0 && "is-active"]}
            data-card-stack-dot
            data-index={i}
            role="tab"
            aria-selected={i === 0 ? "true" : "false"}
            aria-label={`Go to ${cert.title}`}
          />
        ))}
      </div>
      <button type="button" class="card-stack__nav" data-card-stack-next aria-label="Next certificate">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    <p class="card-stack__status" data-card-stack-status aria-live="polite">{certificates[0].title}</p>
  </div>
</section>

<div
  class="cert-preview"
  id="certPreview"
  data-cert-preview
  hidden
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Certificate preview"
>
  <button type="button" class="cert-preview__backdrop" data-cert-preview-close aria-label="Close preview"></button>
  <div class="cert-preview__panel">
    <button type="button" class="cert-preview__close" data-cert-preview-close aria-label="Close preview">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
    <img class="cert-preview__img" data-cert-preview-img alt="" />
  </div>
</div>
