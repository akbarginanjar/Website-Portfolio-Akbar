---
---
<section class="experience" id="experience">
  <div class="section-head">
    <h2 class="section-title" data-split data-i18n="experience.title" data-i18n-direct>Experience</h2>
  </div>
  <div class="timeline">
    <div class="timeline-line" aria-hidden="true"><i id="timelineFill"></i></div>
    <div class="timeline-item" data-reveal>
      <span class="timeline-date" data-i18n="exp1.date" data-i18n-direct>2024 — Present</span>
      <div class="timeline-body">
        <h3 data-i18n="exp1.role" data-i18n-direct>Web & Mobile Developer</h3>
        <p data-i18n="exp1.comp" data-i18n-direct>PT Icommits</p>
      </div>
    </div>
    <div class="timeline-item" data-reveal>
      <span class="timeline-date" data-i18n="exp2.date" data-i18n-direct>2023 — 2024</span>
      <div class="timeline-body">
        <h3 data-i18n="exp2.role" data-i18n-direct>Frontend & Mobile Development</h3>
        <p data-i18n="exp2.comp" data-i18n-direct>Various digital projects</p>
      </div>
    </div>
    <div class="timeline-item" data-reveal>
      <span class="timeline-date" data-i18n="exp3.date" data-i18n-direct>2022 — 2023</span>
      <div class="timeline-body">
        <h3 data-i18n="exp3.role" data-i18n-direct>Junior Web Developer</h3>
        <p data-i18n="exp3.comp" data-i18n-direct>Freelance & contract work</p>
      </div>
    </div>
  </div>
</section>
