---
---
<section class="hero" id="top">
  <canvas id="heroCanvas" class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-inner">
    <div class="hero-content">
      <p class="eyebrow" data-reveal data-i18n="hero.eyebrow" data-i18n-direct>WEB · MOBILE · AI</p>
      <h1 class="hero-title">
        <span class="line" data-hero-line>AKBAR</span>
        <span class="line" data-hero-line>GINANJAR</span>
      </h1>
      <div class="hero-bottom">
        <p class="hero-sub" data-reveal data-i18n="hero.sub" data-i18n-direct>
          Web & Mobile Developer crafting modern digital products with
          Flutter, Laravel, Node.js — and the intelligence to make them think.
        </p>
        <div class="hero-cta" data-reveal>
          <a href="#work" class="btn btn-primary" data-link data-cursor="text" data-cursor-text="VIEW" data-i18n="hero.viewWork">
            <span>View Selected Work</span>
          </a>
          <a href="#contact" class="btn btn-ghost" data-link data-i18n="hero.letsTalk" data-i18n-direct>Let's Talk</a>
        </div>
      </div>
    </div>
    <div class="hero-photo hero-photo-standalone" data-reveal>
      <img src="/assets/akbar.png" alt="Akbar Ginanjar" class="hero-full-portrait" />
    </div>
  </div>
  <div class="hero-status" data-reveal data-i18n="hero.status">
    <span class="status-dot"></span>
    Available for selected projects
  </div>
  <div class="hero-scroll-cue" aria-hidden="true">
    <span data-i18n="hero.scroll" data-i18n-direct>SCROLL</span>
    <div class="scroll-cue-line"><i></i></div>
  </div>
</section>
