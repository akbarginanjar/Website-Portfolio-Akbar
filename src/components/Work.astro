---
const projects = [
  {
    index: "01",
    tags: "WEB · GOVERNMENT",
    label: "DAMKAR",
    tint: "#1E4FA3",
    title: "Damkar Provinsi Jawa Barat",
    desc: "Situs resmi Damkar Provinsi Jawa Barat — informasi publik, peraturan, berita, dan portal data regional.",
    descEn: "Official website of the West Java Fire & Rescue Service — public information, regulations, news, and regional data portals.",
    descId: "Situs resmi Damkar Provinsi Jawa Barat — informasi publik, peraturan, berita, dan portal data regional.",
    descSu: "Situs resmi Damkar Provinsi Jawa Barat — informasi publik, peraturan, berita, sareng portal data regional.",
    projectIndex: "0",
    image: "/assets/projects/damkar.jpg",
  },
  {
    index: "02",
    tags: "AI · WEB · MOBILE",
    label: "MATRIAL",
    tint: "#5B8CFF",
    title: "Matrial",
    desc: "AI-powered material marketplace and intelligent construction analysis platform.",
    projectIndex: "1",
  },
  {
    index: "03",
    tags: "MOBILE · COMMERCE",
    label: "BALANJA",
    tint: "#7A6BFF",
    title: "Balanja Express",
    desc: "Mobile commerce ecosystem connecting customers and drivers in real time.",
    projectIndex: "2",
  },
  {
    index: "04",
    tags: "WEB · GOVERNMENT",
    label: "BPBD JABAR",
    tint: "#4FA8FF",
    title: "BPBD Jawa Barat",
    desc: "Digital platform for regional disaster management and public coordination.",
    projectIndex: "3",
  },
  {
    index: "05",
    tags: "MOBILE · DISASTER MGMT",
    label: "BARATA",
    tint: "#6C9CFF",
    title: "Barata",
    desc: "Mobile application supporting field teams during disaster response operations.",
    projectIndex: "4",
  },
  {
    index: "06",
    tags: "WEB · EDUCATION",
    label: "E-COURSE",
    tint: "#5B8CFF",
    title: "E-Course",
    desc: "Digital learning platform for structured, self-paced online courses.",
    projectIndex: "5",
  },
];
---
<section class="work" id="work">
  <div class="section-head">
    <h2 class="section-title" data-split data-i18n="work.title" data-i18n-direct>Selected Work</h2>
  </div>

  <div class="project-list" id="projectList">
    {projects.map((p) => (
      <article class="project" data-project={p.projectIndex}>
        <div class="project-top">
          <span class="project-tags">{p.tags}</span>
        </div>
        <div class="project-visual">
          <div
            class:list={["project-visual-inner", p.image && "has-image"]}
            style={`--tint:${p.tint};${p.image ? `--project-image:url(${p.image});` : ""}`}
          >
            {!p.image && <span class="project-visual-label">{p.label}</span>}
          </div>
        </div>
        <div class="project-info">
          <h3 class="project-title">{p.title}</h3>
          {p.descEn ? (
            <p
              class="project-desc"
              data-i18n-desc-en={p.descEn}
              data-i18n-desc-id={p.descId}
              data-i18n-desc-su={p.descSu}
            >{p.desc}</p>
          ) : (
            <p class="project-desc">{p.desc}</p>
          )}
        </div>
      </article>
    ))}
  </div>
</section>
