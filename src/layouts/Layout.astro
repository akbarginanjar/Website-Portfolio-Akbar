---
import "@/styles/globals.css";

const SITE_URL = "https://akbarginanjar.vercel.app";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Akbar Ginanjar — Web & Mobile Developer",
  description = "Akbar Ginanjar — Web Developer & Mobile Developer building modern digital products with Flutter, Laravel, Node.js and AI.",
} = Astro.props;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Akbar Ginanjar",
  jobTitle: "Web & Mobile Developer",
  description,
  url: SITE_URL,
  image: `${SITE_URL}/assets/akbar.webp`,
  sameAs: [
    "https://github.com/akbarginanjar",
    "https://www.instagram.com/_peterven",
    "https://www.linkedin.com/in/akbar-ginanjar-a91b2333b",
  ],
  knowsAbout: [
    "Web Development",
    "Mobile Development",
    "Flutter",
    "Laravel",
    "Node.js",
    "AI Integration",
  ],
});
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={SITE_URL} />
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#050505" />
  <meta name="author" content="Akbar Ginanjar" />

  <meta property="og:type" content="website" />
  <meta property="og:url" content={SITE_URL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${SITE_URL}/assets/akbar.webp`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${SITE_URL}/assets/akbar.webp`} />

  <script type="application/ld+json" set:html={jsonLd} />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <link rel="preload" href="/assets/akbar.webp" as="image" fetchpriority="high" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&family=Inter:wght@300..600&display=swap" rel="stylesheet">
</head>
<body>
  <!-- grain / noise overlay -->
  <div class="noise" aria-hidden="true"></div>

  <!-- scroll progress -->
  <div class="scroll-progress" aria-hidden="true"><span id="scrollProgressBar"></span></div>

  <!-- custom cursor -->
  <div class="cursor" id="cursor" aria-hidden="true">
    <div class="cursor-dot" id="cursorDot"></div>
    <div class="cursor-ring" id="cursorRing"><span id="cursorLabel"></span></div>
  </div>

  <a class="skip-link" href="#main">Skip to content</a>

  <slot />

  <script src="../scripts/main.js"></script>
</body>
</html>
